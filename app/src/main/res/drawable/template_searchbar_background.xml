<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Main background color of the search bar -->
    <solid android:color="#2A2A2A"/> <!-- Modern dark gray to contrast against your black background -->

    <!-- Smooth rounded corners -->
    <corners android:radius="24dp"/>

    <!-- Optional: Subtle border line to give it depth -->
    <stroke
        android:width="1dp"
        android:color="#404040"/>
</shape>
