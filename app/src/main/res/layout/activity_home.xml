<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- HEADER BANNER -->
    <EditText
        android:id="@+id/searchBar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/template_searchbar_background"
        android:hint="Search..."
        android:textColor="@android:color/white"
        android:textColorHint="#AAAAAA"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textSize="14sp"
        android:maxLines="1"
        android:imeOptions="actionSearch"
        android:inputType="textCapSentences|textAutoCorrect"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnActionSearch" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnActionSearch"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/searchBar"
        app:layout_constraintBottom_toBottomOf="@id/searchBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:icon="@drawable/icon_search"
        app:iconSize="24dp"
        app:iconTint="@android:color/white"
        android:backgroundTint="#00106A"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        style="@style/Widget.Material3.Button.Icon"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:padding="0dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- MAIN CONTENT VIEW -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchBar"
        app:layout_constraintBottom_toTopOf="@id/bottomMenuBar">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- BOTTOM NAVIGATION BAR -->
    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/bottomBarBorder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:dividerThickness="2dp"
        app:dividerColor="@android:color/black"
        app:layout_constraintBottom_toTopOf="@id/layout_download_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/layout_download_progress"
        layout="@layout/layout_download_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/bottomMenuBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/bottomMenuBar"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:background="@color/navbar_background_color"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btnYoutubeHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/tab_youtube_home"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Dashboard"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:paddingBottom="20dp" />
        <ImageButton
            android:id="@+id/btnYoutubeShorts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/tab_shorts"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Shorts"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:paddingBottom="20dp" />
        <ImageButton
            android:id="@+id/btnAniHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/icon_ani_home"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Anime"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:paddingBottom="20dp"
            android:paddingTop="5dp" />
        <ImageButton
            android:id="@+id/btnDownloads"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/tab_downloads"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Downloads"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:paddingBottom="20dp" />
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/tab_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:paddingBottom="20dp" />
    </LinearLayout>

    <!-- LOADING INDICATOR -->
    <ProgressBar
        android:id="@+id/loadingSpinner"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/swipeRefreshLayout"
        app:layout_constraintBottom_toBottomOf="@id/swipeRefreshLayout"
        app:layout_constraintStart_toStartOf="@id/swipeRefreshLayout"
        app:layout_constraintEnd_toEndOf="@id/swipeRefreshLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>
