<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- BOTTOM NAVIGATION BAR -->
    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/bottomBarBorder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:dividerThickness="2dp"
        app:dividerColor="@android:color/black"
        app:layout_constraintBottom_toTopOf="@id/bottomMenuBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout
        android:id="@+id/bottomMenuBar"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:background="@color/navbar_background_color"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btnYoutubeHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/tab_youtube_home"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Dashboard"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:paddingBottom="20dp" />
        <ImageButton
            android:id="@+id/btnYoutubeShorts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/tab_shorts"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Shorts"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:paddingBottom="20dp" />
        <ImageButton
            android:id="@+id/btnAniHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/icon_ani_home"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Anime"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:paddingBottom="20dp"
            android:paddingTop="5dp" />
        <ImageButton
            android:id="@+id/btnDownloads"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/tab_downloads"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Downloads"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:paddingBottom="20dp" />
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/tab_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:paddingBottom="20dp" />
    </LinearLayout>

    <!-- SHORTS FEED CONTENT -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomMenuBar">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:scrollbars="none" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- TOP-RIGHT OVERLAY BUTTON: DOWNLOADS MANAGER -->
    <ImageButton
        android:id="@+id/btnDownloadedShorts"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Manage Downloaded Shorts"
        android:elevation="8dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/download_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- LOADING SPINNER -->
    <ProgressBar
        android:id="@+id/loadingSpinner"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/swipeRefreshLayout"
        app:layout_constraintBottom_toBottomOf="@id/swipeRefreshLayout"
        app:layout_constraintStart_toStartOf="@id/swipeRefreshLayout"
        app:layout_constraintEnd_toEndOf="@id/swipeRefreshLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>