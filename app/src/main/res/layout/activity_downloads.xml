<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">
    <!-- BOTTOM NAVIGATION BAR -->
    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/bottomBarBorder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:dividerThickness="2dp"
        app:dividerColor="@android:color/black"
        app:layout_constraintBottom_toTopOf="@id/layout_download_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/layout_download_progress"
        layout="@layout/layout_download_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/bottomMenuBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/bottomMenuBar"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:background="@color/navbar_background_color"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btnYoutubeHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/tab_youtube_home"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Dashboard"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:paddingBottom="20dp" />
        <ImageButton
            android:id="@+id/btnYoutubeShorts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/tab_shorts"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Shorts"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:paddingBottom="20dp" />
        <ImageButton
            android:id="@+id/btnAniHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/icon_ani_home"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Anime"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:paddingBottom="20dp"
            android:paddingTop="5dp" />
        <ImageButton
            android:id="@+id/btnDownloads"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/tab_downloads"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Downloads"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:paddingBottom="20dp" />
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/tab_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:paddingBottom="20dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/home_text_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Downloads"
        android:textSize="36sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnPlayFolder"
        app:layout_constraintHorizontal_bias="0.5" />

    <ImageButton
        android:id="@+id/btnPlayFolder"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/icon_play_playlist"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Play All"
        app:layout_constraintTop_toTopOf="@id/home_text_banner"
        app:layout_constraintBottom_toBottomOf="@id/home_text_banner"
        app:layout_constraintEnd_toStartOf="@id/btnCreateFolder" />

    <ImageButton
        android:id="@+id/btnCreateFolder"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/icon_folder"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Create Folder"
        app:layout_constraintTop_toTopOf="@id/home_text_banner"
        app:layout_constraintBottom_toBottomOf="@id/home_text_banner"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/navbarBarrier"
        android:layout_width="0dp"
        android:layout_height="16dp"
        app:layout_constraintTop_toBottomOf="@id/home_text_banner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navbarBarrier"
        app:layout_constraintBottom_toTopOf="@id/bottomMenuBar">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <ProgressBar
        android:id="@+id/loadingSpinner"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/swipeRefreshLayout"
        app:layout_constraintBottom_toBottomOf="@id/swipeRefreshLayout"
        app:layout_constraintStart_toStartOf="@id/swipeRefreshLayout"
        app:layout_constraintEnd_toEndOf="@id/swipeRefreshLayout" />
</androidx.constraintlayout.widget.ConstraintLayout>
